{
  "name": "start-server-and-test-test",
  "version": "1.0.0",
  "description": "Test start-server-and-test with Cypress",
  "main": "index.js",
  "scripts": {
    "start": "http-server -c-1 --silent",
    "cy:run": "cypress run",
    "test": "start-server-and-test start http://localhost:8080 cy:run",
    "ci-1": "start-server-and-test 'http-server -c-1 --silent' 8080 'cypress run --spec cypress/e2e/spec.cy.js'",
    "ci-2": "start-server-and-test 8080 'cypress run --spec cypress/e2e/spec.cy.js'",
    "ci-3": "start-server-and-test 'http-server -c-1 --silent' 8080 'mocha e2e-spec.js'"
  },
  "author": "Mike McCready",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "cypress": "^15.13.0",
    "http-server": "^14.1.1",
    "start-server-and-test": "^3.0.0"
  }
}
